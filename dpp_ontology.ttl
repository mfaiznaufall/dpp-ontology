@prefix : <http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-10/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-10/> .

<http://thesis.tudelft.nl/dpp> rdf:type owl:Ontology ;
                                owl:imports <http://www.w3.org/ns/sosa/> ;
                                rdfs:comment "Minimal DPP Ontology for instance-specific construction process data. Developed for MSc thesis at TU Delft." ;
                                rdfs:label "DPP Ontology for Construction Process Data" .

#################################################################
#    Object Properties
#################################################################

###  http://thesis.tudelft.nl/dpp#hasEnvironmentalConditions
:hasEnvironmentalConditions rdf:type owl:ObjectProperty ;
                            rdfs:domain :DigitalProductPassport ;
                            rdfs:range :EnvironmentalConditions ;
                            rdfs:comment "Links a Digital Product Passport to its environmental conditions recorded during construction" ;
                            rdfs:label "has environmental conditions" .


###  http://thesis.tudelft.nl/dpp#recordedBy
:recordedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :EnvironmentalConditions ;
            rdfs:comment "Links environmental conditions to the AiC agent that recorded the data on the Digital Twin side" ;
            rdfs:label "recorded by" .


###  http://thesis.tudelft.nl/dpp#relatedToActivity
:relatedToActivity rdf:type owl:ObjectProperty ;
                   rdfs:domain :EnvironmentalConditions ;
                   rdfs:comment "Links environmental conditions to the AiC construction activity during which the data was recorded" ;
                   rdfs:label "related to activity" .


###  http://www.w3.org/ns/sosa/hasFeatureOfInterest
<http://www.w3.org/ns/sosa/hasFeatureOfInterest> rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                                 rdfs:range <http://www.w3.org/ns/sosa/FeatureOfInterest> .


###  http://www.w3.org/ns/sosa/hasResult
<http://www.w3.org/ns/sosa/hasResult> rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                      rdfs:range :EnvironmentalConditions .


###  http://www.w3.org/ns/sosa/madeBySensor
<http://www.w3.org/ns/sosa/madeBySensor> rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                         rdfs:range <http://www.w3.org/ns/sosa/Sensor> .


#################################################################
#    Data properties
#################################################################

###  http://thesis.tudelft.nl/dpp#hasTVOC
:hasTVOC rdf:type owl:DatatypeProperty ;
         rdfs:domain :EnvironmentalConditions ;
         rdfs:range xsd:integer ;
         rdfs:comment "The Total Volatile Organic Compounds concentration in parts per billion (ppb) measured by the SGP30 sensor during construction" ;
         rdfs:label "has TVOC value" .


###  http://thesis.tudelft.nl/dpp#haseCO2
:haseCO2 rdf:type owl:DatatypeProperty ;
         rdfs:domain :EnvironmentalConditions ;
         rdfs:range xsd:integer ;
         rdfs:comment "The equivalent CO2 concentration in parts per million (ppm) measured by the SGP30 sensor during construction" ;
         rdfs:label "has eCO2 value" .


#################################################################
#    Classes
#################################################################

###  http://thesis.tudelft.nl/dpp#DigitalProductPassport
:DigitalProductPassport rdf:type owl:Class ;
                        rdfs:comment "An instance-specific Digital Product Passport for a construction product, capturing process data recorded during installation. Concept based on Kebede et al. (2024)." ;
                        rdfs:label "Digital Product Passport" .


###  http://thesis.tudelft.nl/dpp#EnvironmentalConditions
:EnvironmentalConditions rdf:type owl:Class ;
                         rdfs:subClassOf <http://www.w3.org/ns/sosa/Result> ;
                         rdfs:comment "Sensor-captured environmental conditions during a construction activity. Subclass of sosa:Result." ;
                         rdfs:label "Environmental Conditions" .


